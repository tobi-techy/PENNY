# Penny engine env. Copy to .env and fill. Never commit real values.
PENNY_ENV=dev                 # dev | mainnet
DRY_RUN=1                     # 1 = quote/simulate only. Mainnet relay needs PENNY_ENV=mainnet AND DRY_RUN=0 AND relayer key.
PORT=8787
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:8787   # used to build card URLs
DATABASE_URL=                 # postgres://... (Neon). Empty in dev = in-memory pglite.

# Photon / Spectrum (Stable docs, https://photon.codes/docs)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SPECTRUM_WEBHOOK_SECRET=      # signing secret returned when registering the webhook (64 chars)
IMESSAGE_APP_NAME=Penny
IMESSAGE_EXTENSION_BUNDLE_ID=money.penny.host.messages
IMESSAGE_TEAM_ID=

# NEAR AI Cloud (OpenAI-compatible gateway)
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_API_KEY=
NEARAI_MODEL=z-ai/glm-5.3-flash
NEARAI_ROUTER_MODEL=z-ai/glm-5.3-flash
NEARAI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Composio Platform (users connect Gmail/GitHub/etc. via Connect Links; backend-only key)
COMPOSIO_API_KEY=

# NEAR chain (keys only via env/KMS; required when PENNY_ENV=mainnet)
NEAR_NETWORK=testnet
NEAR_APP_ACCOUNT_ID=penny.near
NEAR_RELAYER_ACCOUNT_ID=
NEAR_RELAYER_PRIVATE_KEY=
NEAR_RPC_URL=

# Optional tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Limits
RATE_LIMIT_PER_IP_PER_MIN=120
RATE_LIMIT_PER_USER_PER_MIN=30
MAX_BODY_BYTES=65536
