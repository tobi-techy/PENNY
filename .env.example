# Penny engine env. Copy to .env and fill. Never commit real values.
PENNY_ENV=dev                 # dev | mainnet
DRY_RUN=1                     # 1 = quote/simulate only. Mainnet relay needs PENNY_ENV=mainnet AND DRY_RUN=0 AND relayer key.
PORT=8787
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:8787   # used to build card URLs
PENNY_TIMEZONE=Africa/Lagos              # "now" for the crew; bill reminders go out 09:00 local the day before
PENNY_DEMO_BILLER_ACCOUNT=                # optional: NEAR account you control (e.g. penny-demo-biller.testnet); "Penny Demo Utility" bills in USD become payable to it: real testnet NEAR on a testnet RPC, USDC on mainnet
DATABASE_URL=                 # postgres://... (Neon). Empty in dev = in-memory pglite.

# Photon / Spectrum (Stable docs, https://photon.codes/docs). Cloud package @spectrum-ts/imessage.
SPECTRUM_PROJECT_ID=
SPECTRUM_SECRET=              # project secret (old name SPECTRUM_PROJECT_SECRET still works)
SPECTRUM_WEBHOOK_SECRET=      # signing secret returned when registering the webhook (64 chars)
IMESSAGE_APP_NAME=Penny
# Live cards (customizedMiniApp): the iMessage extension that draws them
APPLE_TEAM_ID=                # 10-char Apple team id (old name IMESSAGE_TEAM_ID still works)
PENNY_IOS_BUNDLE_ID=          # host app bundle id, e.g. app.penny.host (gives APP_ATTEST_APP_ID)
PENNY_IMESSAGE_EXT_BUNDLE_ID= # extension bundle id, e.g. app.penny.host.messages

# NEAR AI Cloud (OpenAI-compatible gateway)
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_API_KEY=
NEARAI_MODEL=z-ai/glm-5.3-flash
NEARAI_ROUTER_MODEL=z-ai/glm-5.3-flash
NEARAI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# TEE attestation (docs/TEE.md): off | warn | enforce
NEARAI_ATTESTATION=enforce
NEARAI_ATTESTATION_TTL_SEC=300

# Composio Platform (users connect Gmail/GitHub/etc. via Connect Links; backend-only key)
COMPOSIO_API_KEY=

# NEAR chain (keys only via env/KMS; required when PENNY_ENV=mainnet)
NEAR_NETWORK=testnet
NEAR_APP_ACCOUNT_ID=penny.near
NEAR_RELAYER_ACCOUNT_ID=
NEAR_RELAYER_PRIVATE_KEY=
NEAR_RPC_URL=
PENNY_RELAYER_MAX_DEPOSIT_NEAR=1      # hard ceiling on NEAR the relayer fronts for one approval
PENNY_MAINNET_MAX_PER_TX_USD=25       # mainnet launch cap, clamped over user policy
PENNY_MAINNET_MAX_DAILY_USD=50        # mainnet launch cap on the daily total

# Invest (NEAR Intents 1Click). Without a key or JWT, 1Click adds a 0.2% fee (shown on the card).
ONECLICK_API_KEY=
ONECLICK_JWT=
INVEST_SLIPPAGE_BPS=100

# Optional tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Testnet proof (bun run prove). Testnet only: the engine refuses to boot with it on mainnet.
PENNY_PROVE_SECRET=           # >= 32 random chars; also set where you run `bun run prove`
# Only where you run `bun run prove` (never on the engine):
# PENNY_PROVE_ACCOUNT_ID=     # a funded *.testnet account
# PENNY_PROVE_PRIVATE_KEY=    # its TEST full-access key (ed25519:...), testnet only

# Limits
RATE_LIMIT_PER_IP_PER_MIN=120
RATE_LIMIT_PER_USER_PER_MIN=30
MAX_BODY_BYTES=65536
