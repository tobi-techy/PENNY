{
  "name": "penny",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev": "bun run --cwd apps/engine dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  }
}
